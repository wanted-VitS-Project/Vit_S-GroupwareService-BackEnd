# ============================================================
# VitaminS ② Spring 배포 .env 템플릿 (커밋됨 · PUBLIC 레포)
#   실값은 GitHub Secrets/Variables → 러너가 조립 → S3(SSE) → EC2.
#   이 파일은 "키 계약서"다. 실제 값은 절대 여기 커밋하지 않는다.
#   S3 인증은 EC2 인스턴스 role → AWS 액세스키 없음(코드봄바 GCP키와 다른 점).
#   [S]=GitHub Secrets  [V]=GitHub Variables  로 등록.
# ============================================================

# --- 프로필 (러너가 주입 · 등록 불필요) ---
SPRING_PROFILES_ACTIVE=prod        # ⚠️ 빠지면 Swagger 전체 노출

# --- DB (team05 RDS 재사용 · DB명은 vitamins) ---
DB_URL=                            # [V] jdbc:mysql://<rds>:3306/vitamins?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=                       # [V] admin
DB_PASSWORD=                       # [S]

# --- Redis (compose 동거 · 서비스명 redis) ---
REDIS_HOST=redis                   # [V]
REDIS_PORT=6379                    # [V] (선택)
REDIS_PASSWORD=                    # [S] compose가 --requirepass로 요구
SESSION_TIMEOUT=4h                 # [V] (선택)

# --- Mail (Gmail 앱 비밀번호) ---
MAIL_USERNAME=                     # [V] (Gmail 주소)
MAIL_PASSWORD=                     # [S] 계정 비번 아님 · 앱 비밀번호 16자리

# --- CORS / 메일 링크 (실도메인) ---
CORS_ALLOWED_ORIGINS=              # [V] 예: https://<도메인>
APP_LOGIN_URL=                     # [V] 예: https://<도메인>/login

# --- AWS S3 (인증 = 인스턴스 role · 키 없음) ---
AWS_REGION=ap-northeast-2          # [V]
S3_BUCKET_NAME=                    # [V] 예: vitamins-files

# --- 정산 계좌 암호화 (Base64 AES-256 32바이트) ---
SETTLEMENT_ACCOUNT_ENC_KEY=        # [S] 없으면 기동 실패

# --- Vitamate 워커 / 나라장터 (기능 켤 때만) ---
VITAMATE_WORKER_TOKEN=             # [S] (선택) 파이썬 레포와 **같은 값**이어야 워커 인증 통과
NARA_API_BASE_URL=                 # [V] (선택) 빈 값이면 나라장터 호출이 조용히 실패
NARA_API_SERVICE_KEY=              # [S] (선택)

# --- 입찰 수집 워커 (Redis Stream 소비) ---
#  🚨 BIDDING_COLLECTION_WORKER_ENABLED 는 RedisCollectionRunJobConsumer 의
#     @ConditionalOnProperty 게이트다. 빠지면 빈이 **등록조차 안 되고**
#     예외·로그 없이 수집만 안 돈다(기동·API 는 정상이라 안 보인다).
BIDDING_COLLECTION_WORKER_ENABLED= # [V] true 로 명시해야 켜진다 (기본 꺼짐)
BIDDING_WORKER_TOKEN=              # [S] 파이썬 레포와 **같은 값**

# --- (선택) 튜닝 · 미설정 시 application.yml 기본값 유지 ---
# ARGON2_MEMORY_KB=65536
# ARGON2_ITERATIONS=3
# LOGIN_LOCK_THRESHOLD=5
# LOGIN_LOCK_DURATION=10m

# --- compose 인터폴레이션용 (러너가 주입 · 등록 불필요) ---
# ECR_REGISTRY=<runtime>           # ECR 로그인 스텝 출력값. compose image 참조에 쓰임
