<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.group3.vitamins.checklist.infrastructure.blockdetail.ChecklistDetailMapper">

    <select id="findItemsByChkBlockIds"
            resultType="com.group3.vitamins.checklist.infrastructure.blockdetail.ChecklistItemRow">
        SELECT chk_block_id AS chkBlockId,
        chk_id       AS chkId,
        content      AS content,
        is_completed AS isCompleted
        FROM checklist
        WHERE chk_block_id IN
        <foreach item="id" collection="chkBlockIds" open="(" separator="," close=")">#{id}</foreach>
        AND deleted_at IS NULL
        ORDER BY chk_block_id, chk_id
    </select>

</mapper>
