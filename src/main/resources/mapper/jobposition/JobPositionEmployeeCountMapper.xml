<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  직급별 사용 인원 집계 SQL (사원 도메인 소관 employee 테이블).
  쓰기·단건 조회는 JPA(JobPositionRepositoryAdapter) 담당.
  namespace = Mapper 인터페이스 전체 경로 · id = 메서드명 (팀 MyBatis 컨벤션).
  집계 제외 기준은 부서 인원 집계와 동일: is_system=0 AND resigned_at IS NULL AND deleted_at IS NULL.
-->
<mapper namespace="com.group3.vitamins.jobposition.infrastructure.adapter.JobPositionEmployeeCountMapper">

    <!-- record 는 setter 가 없어 생성자 인자로 매핑한다 (인자 순서 = record 정의 순서) -->
    <resultMap id="jobPositionEmployeeCountRow"
               type="com.group3.vitamins.jobposition.application.result.JobPositionEmployeeCountRow">
        <constructor>
            <idArg column="job_position_id" javaType="java.lang.Long"/>
            <arg column="employee_count" javaType="_int"/>
        </constructor>
    </resultMap>

    <!--
      직급별 사용 인원. 인원 0 인 직급은 결과에 없다(서비스에서 0 으로 채운다).
      job_position_id IS NULL(직급 미배정) 사원은 GROUP BY 대상에서 자연히 빠진다.
    -->
    <select id="countByJobPosition" resultMap="jobPositionEmployeeCountRow">
        SELECT e.job_position_id AS job_position_id,
               COUNT(*)          AS employee_count
          FROM employee e
         WHERE e.job_position_id IS NOT NULL
           AND e.is_system = 0
           AND e.resigned_at IS NULL
           AND e.deleted_at IS NULL
         GROUP BY e.job_position_id
    </select>

    <!-- 수정 응답 표시용 직급 1건 사용 인원. 목록과 같은 제외 기준을 쓴다. -->
    <select id="countByJobPositionId" resultType="long">
        SELECT COUNT(*)
          FROM employee e
         WHERE e.job_position_id = #{jobPositionId}
           AND e.is_system = 0
           AND e.resigned_at IS NULL
           AND e.deleted_at IS NULL
    </select>

    <!--
      삭제 차단 판정용 — 직급을 참조하는 모든 사원 수(필터 없음).
      퇴사자·삭제 사원·시스템 계정도 employee.job_position_id FK 로 직급 행을 물리적으로 참조하므로,
      표시용 집계처럼 제외하고 세면 하드 삭제 시 FK 제약(fk_employee_job_position) 위반이 난다.
    -->
    <select id="countAllReferencing" resultType="long">
        SELECT COUNT(*)
          FROM employee e
         WHERE e.job_position_id = #{jobPositionId}
    </select>

</mapper>
