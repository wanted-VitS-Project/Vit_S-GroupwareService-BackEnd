<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  부서·사원 조인 조회 SQL. 쓰기·단건 조회는 JPA(DepartmentRepositoryAdapter) 담당.
  namespace = Mapper 인터페이스 전체 경로 · id = 메서드명 (팀 MyBatis 컨벤션).
-->
<mapper namespace="com.group3.vitamins.department.infrastructure.adapter.DepartmentEmployeeQueryMapper">

    <!-- record 는 setter 가 없어 생성자 인자로 매핑한다 (인자 순서 = record 정의 순서) -->
    <resultMap id="departmentEmployeeCountRow"
               type="com.group3.vitamins.department.application.result.DepartmentEmployeeCountRow">
        <constructor>
            <idArg column="department_id" javaType="java.lang.Long"/>
            <arg column="name" javaType="java.lang.String"/>
            <arg column="parent_id" javaType="java.lang.Long"/>
            <arg column="direct_employee_count" javaType="_int"/>
        </constructor>
    </resultMap>

    <!--
      전체 부서 + 직속 인원. LEFT JOIN 이라 사원 0명 부서도 남는다.
      인원 집계에서 시스템 계정·퇴사자 제외 (is_system=0 AND resigned_at IS NULL AND deleted_at IS NULL).
    -->
    <select id="findAllWithDirectEmployeeCount" resultMap="departmentEmployeeCountRow">
        SELECT d.department_id,
               d.name,
               d.parent_id,
               COUNT(e.user_id) AS direct_employee_count
          FROM department d
          LEFT JOIN employee e
            ON e.department_id = d.department_id
           AND e.is_system = 0
           AND e.resigned_at IS NULL
           AND e.deleted_at IS NULL
         GROUP BY d.department_id, d.name, d.parent_id
         ORDER BY d.department_id
    </select>

    <!-- 삭제 차단 판정용 직속 사원 수. 목록과 같은 제외 기준을 쓴다. -->
    <select id="countDirectEmployees" resultType="long">
        SELECT COUNT(*)
          FROM employee e
         WHERE e.department_id = #{departmentId}
           AND e.is_system = 0
           AND e.resigned_at IS NULL
           AND e.deleted_at IS NULL
    </select>

</mapper>
