# docker compose 전용 변수 템플릿
#
# 사용법
#   cp .env.example .env      (포트를 바꿔야 할 때만 필요하다. 기본값으로 충분하면 안 만들어도 된다)
#
# ⚠️ 여기는 **컨테이너를 만드는 값**만 둔다. 앱 설정은 여기가 아니다.
#    Spring 은 .env 를 읽지 않는다 → 앱 설정은 `application-local.yml` 에 쓴다
#    (템플릿: src/main/resources/application-local.yml.example)
#
# ⚠️ .env 는 커밋되지 않는다 (.gitignore). 이 레포는 PUBLIC 이므로
#    실제 운영 값은 이 파일에도, 복사본에도 쓰지 마라. 아래는 전부 로컬 컨테이너 전용이다.

# ── MySQL 컨테이너 ───────────────────────────────────────
# 🚨 이 값들을 바꾸면 application-local.yml 의 datasource 도 **같이** 바꿔야 한다.
#    한쪽만 바꾸면 컨테이너는 뜨는데 앱이 못 붙는다. 가장 흔한 실수다.
MYSQL_ROOT_PASSWORD=local-root-password
MYSQL_DATABASE=vitamins
MYSQL_USER=vitamins
MYSQL_PASSWORD=local-password

# 🚨 로컬에 이미 MySQL 이 떠 있으면 3306 충돌로 컨테이너가 시작되지 않는다
#    ("bind: address already in use"). 흔한 상황이다 — Homebrew MySQL 은 로그인 시 자동 시작된다.
#    확인:  lsof -nP -iTCP:3306 -sTCP:LISTEN
#    해결:  아래를 3307 로 바꾸고 application-local.yml 의 url 포트도 3307 로 바꾼다
#          (기존 MySQL 을 끄고 싶으면 brew services stop mysql)
MYSQL_PORT=3306

# ── Redis 컨테이너 ───────────────────────────────────────
REDIS_PORT=6379
